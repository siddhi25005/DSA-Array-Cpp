#include<iostream>
#include<vector>
using namespace std;
vector<vector<int>>pascal(int n) {
    vector<vector<int>>tri;
    for(int i=0;i<n;i++) {
        vector<int>row(i+1,1);
        for(int j=1;j<i;j++) 
        row[j]=tri[i-1][j-1]+tri[i-1][j];
        tri.push_back(row);
    }
    return tri;
}
int main() {
    int n;
    cout<<"enter n :";
    cin>>n;
    vector<vector<int>>result=pascal(n);
    for(auto row:result) {
        for(int i:row) 
        cout<<i<<" ";
        cout<<endl;
    }
}
