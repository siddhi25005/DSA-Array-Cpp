#include<iostream>
#include<vector>
using namespace std;
vector<int>pascal(int n) {
    vector<int>row;
    for(int i=0;i<n;i++) {
        vector<int>newrow(i+1,1);
        for(int j=1;j<i;j++)
        newrow[j]=row[j]+row[j-1];
        row=newrow;
    }
    return row;
}
int main() {
    int n;
    cout<<"enter n :";
    cin>>n;
    vector<int>result=pascal(n);
    for(int i:result) {
        cout<<i<<" ";
    }
}
